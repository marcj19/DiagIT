{
  "_sobre": "Drivers que aparecem como culpados de telas azuis (evento 1019 do Windows ou o próprio arquivo da tela azul). 'arquivo' = começo do nome do arquivo (minúsculo). 'tipo' escolhe o conselho em 'tipos'. 'nucleo': true = é o próprio Windows; nesse caso o culpado real costuma ser memória, hardware ou outro driver, e o diagnóstico não tira peso do hardware.",
  "tipos": {
    "video": {
      "frase": "o driver de vídeo",
      "conselho": "Reinstale o driver de vídeo do jeito certo: baixe a versão mais recente no site do fabricante, remova o atual com o DDU em modo de segurança e instale o baixado (Resolver → Driver de vídeo). Se as telas azuis começaram depois de uma atualização, instale a versão anterior. Remova overclock/undervolt no {painel_video}. Se continuar com o driver limpo, rode o teste da placa de vídeo.",
      "pesos": { "Software": 0.45, "Gpu": 0.20 }
    },
    "rede": {
      "frase": "o driver de rede",
      "conselho": "Atualize o driver da placa de rede pelo site do fabricante da placa-mãe ou do adaptador (não pelo Windows Update). Para testar, desative o adaptador no Gerenciador de Dispositivos e use outro (cabo ou Wi-Fi) por alguns dias.",
      "pesos": { "Software": 0.45 }
    },
    "audio": {
      "frase": "o driver de áudio",
      "conselho": "Atualize o driver de áudio pelo site do fabricante da placa-mãe. Desinstale programas de áudio extras (equalizadores, som virtual). Se o driver for de áudio HDMI da placa de vídeo, ele é reinstalado junto com o driver de vídeo.",
      "pesos": { "Software": 0.45 }
    },
    "armazenamento": {
      "frase": "o driver de armazenamento",
      "conselho": "Atualize o driver de chipset/armazenamento e o firmware do SSD (programa do fabricante do SSD) e rode o teste de armazenamento. Confira o cabo e a porta do disco.",
      "pesos": { "Software": 0.30, "Disk": 0.20 }
    },
    "chipset": {
      "frase": "o driver do chipset",
      "conselho": "Instale o driver de chipset mais recente do site do fabricante da placa-mãe (ou da AMD/Intel) e atualize a BIOS.",
      "pesos": { "Software": 0.40, "Board": 0.10 }
    },
    "usb": {
      "frase": "o driver de USB",
      "conselho": "Desconecte hubs, adaptadores e periféricos USB não essenciais e teste por alguns dias. Atualize o driver de chipset e a BIOS; se repetir com um aparelho específico, ele é o suspeito.",
      "pesos": { "Software": 0.35, "Board": 0.10 }
    },
    "anticheat": {
      "frase": "o anti-cheat de um jogo",
      "conselho": "Atualize o jogo e o anti-cheat (reinstale o serviço do anti-cheat pela página do jogo). Anti-cheats em nível de kernel conflitam com ferramentas de overclock, monitoramento e RGB: feche-as ao jogar.",
      "pesos": { "Software": 0.45 }
    },
    "antivirus": {
      "frase": "o antivírus",
      "conselho": "Atualize o antivírus ou desinstale-o para testar (o Windows Defender já protege o PC). Dois antivírus instalados ao mesmo tempo causam travamentos.",
      "pesos": { "Software": 0.45 }
    },
    "monitoramento": {
      "frase": "um programa de monitoramento ou overclock",
      "conselho": "Desinstale programas de overclock, RGB ou monitoramento que instalam driver próprio (este é um deles) e veja se as telas azuis param.",
      "pesos": { "Software": 0.45 }
    },
    "virtualizacao": {
      "frase": "um driver de virtualização",
      "conselho": "Atualize ou desinstale o programa de máquina virtual/emulador dono deste driver e teste por alguns dias.",
      "pesos": { "Software": 0.40 }
    },
    "windows": {
      "frase": "o próprio Windows",
      "conselho": "Quando a falha aparece dentro do próprio Windows, a causa costuma ser memória instável, hardware ou outro driver que corrompeu a memória. Rode o teste de memória e o reparo de arquivos do Windows (Resolver).",
      "pesos": { }
    }
